generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pedido {
  id            Int      @id @default(autoincrement())
  produtoId     Int
  quantidade    Int
  clienteEmail  String
  precoUnitario Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  status        String   @default("CONFIRMADO")
  criadoEm      DateTime @default(now())
}